<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream"
    android:gravity="center"
    android:padding="32dp">

    <!-- Icon Centang Hijau (lingkaran) -->
    <LinearLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/circle_green_bg"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textSize="60sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins_bold" />
    </LinearLayout>

    <!-- Judul -->
    <TextView
        android:id="@+id/tvConfirmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirm_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/brown_dark"
        android:fontFamily="@font/poppins_bold"
        android:layout_marginBottom="16dp" />

    <!-- Pesan -->
    <TextView
        android:id="@+id/tvConfirmMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirm_message"
        android:textSize="16sp"
        android:textColor="@color/brown_light"
        android:fontFamily="@font/poppins_regular"
        android:textAlignment="center"
        android:layout_marginBottom="48dp" />

    <!-- Tombol Oke -->
    <Button
        android:id="@+id/btnOk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_ok"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_bold"
        android:backgroundTint="@color/brown_primary"
        android:textColor="@color/white"
        android:padding="14dp" />

</LinearLayout>