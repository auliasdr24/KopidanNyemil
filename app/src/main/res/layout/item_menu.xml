<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/edittext_bg"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical">

    <!-- Gambar Menu -->
    <ImageView
        android:id="@+id/ivMenuImage"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/menu_kopi_susu"
        android:scaleType="centerCrop"
        android:background="@drawable/image_rounded_bg"
        android:clipToOutline="true"
        android:layout_marginEnd="16dp"
        android:contentDescription="Gambar Menu" />

    <!-- Info menu: nama + deskripsi + harga -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMenuName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kopi Susu Gula Aren"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/brown_dark"
            android:fontFamily="@font/poppins_semibold" />

        <TextView
            android:id="@+id/tvMenuDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kopi susu dengan gula aren asli"
            android:textSize="12sp"
            android:textColor="@color/brown_light"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvMenuPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 22.000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brown_primary"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>