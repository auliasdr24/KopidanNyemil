<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream"
    android:gravity="center"
    android:padding="32dp">

    <!-- Logo kecil di atas -->
    <ImageView
        android:id="@+id/ivLogoSmall"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/logo_kopi"
        android:layout_marginBottom="24dp"
        android:contentDescription="Logo Kopi dan Nyemil" />

    <!-- Judul -->
    <TextView
        android:id="@+id/tvSignupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/signup_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/brown_dark"
        android:fontFamily="@font/poppins_bold"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSignupSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/signup_subtitle"
        android:textSize="14sp"
        android:textColor="@color/brown_light"
        android:fontFamily="@font/poppins_regular"
        android:textAlignment="center"
        android:layout_marginBottom="48dp" />

    <!-- Tombol Register -->
    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_register"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_bold"
        android:backgroundTint="@color/brown_primary"
        android:textColor="@color/white"
        android:padding="14dp"
        android:layout_marginBottom="16dp" />

    <!-- Tombol Login -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_login"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_bold"
        android:backgroundTint="@color/caramel"
        android:textColor="@color/brown_dark"
        android:padding="14dp" />

</LinearLayout>